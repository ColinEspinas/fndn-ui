{
  "name": "@fndn/components",
  "private": true,
  "version": "0.1.0",
  "description": "Every component, one folder each: its spec, recipe, logic, React, Vue and Svelte adapters, test, fixtures and examples. lib/ holds what they share. They reach a project as source files through fndn.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.react.json && vue-tsc -p tsconfig.vue.json --noEmit && svelte-check --tsconfig ./tsconfig.svelte.json"
  },
  "dependencies": {
    "@ark-ui/react": "^5.40.0",
    "@ark-ui/svelte": "^5.25.1",
    "@ark-ui/vue": "^5.40.0",
    "@codemirror/commands": "^6.11.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.1",
    "@phosphor-icons/react": "^2.1.10",
    "@phosphor-icons/vue": "^2.2.1",
    "glimm": "^0.4.1",
    "phosphor-svelte": "^3.1.1",
    "tailwind-variants": "4.0.2"
  },
  "devDependencies": {
    "@fndn/react": "workspace:*",
    "@fndn/svelte": "workspace:*",
    "@fndn/vue": "workspace:*",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svelte": "^5.45.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.3",
    "vue": "^3.5.0",
    "vue-tsc": "^3.1.0"
  }
}
