---
/* Foundations: the token tables, generated from spec/tokens.json and spec/icons.json. Static HTML; the motion samples and the icon filter are
 * small islands. Token values are shown as data: a swatch paints the value a token holds. */
import Layout from "../../layouts/Layout.astro";
import MotionFoundation from "../../components/MotionFoundation";
import IconFilter from "../../components/IconFilter";
import { tokens } from "@fndn/core/tokens";
import { iconNames, icons, iconSvg } from "../../../../../packages/core/src/icons";
import { FOUNDATIONS } from "../../lib/types";
import { INTRO, both, desc, groupDesc, motionRows, timings, timingsDescription } from "../../lib/foundations";

export function getStaticPaths() {
  return FOUNDATIONS.map(([id, label]) => ({ params: { id }, props: { label } }));
}
const { label } = Astro.props;
const id = Astro.params.id!;
const motion = id === "motion" ? motionRows() : null;
const th = "border-b border-line px-3 py-2 text-start text-xs font-medium text-ink-2";
const td = "border-b border-line-soft px-3 py-2.5 align-middle text-sm text-ink [unicode-bidi:plaintext]";
const tdMuted = `${td} text-ink-2`;
const code = "font-mono text-xs text-ink";
const codeMuted = "font-mono text-xs text-ink-2";
const table = "w-full min-w-[40rem] border-collapse";
const box = "overflow-x-auto overscroll-x-contain rounded-card border border-line bg-surface";
/* the page and hairline colours of each theme, behind the colour swatches */
const PAGE = both(tokens.color.page), LINE = both(tokens.color.line);
const SAMPLE = "Annual plans are the fastest-growing segment this week";
---
<Layout title={label} current={`/foundations/${id}`} description={INTRO[id]}>
  <div class="px-4 pt-10 pb-20 md:px-8">
  <div class="mx-auto max-w-[55rem]" data-docs-foundation={id}>
    <header class="max-w-[46rem]">
      <p class="text-sm text-ink-2">Foundations</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight text-ink">{label}</h1>
      <p class="mt-3 text-md leading-relaxed text-ink-2 [unicode-bidi:plaintext]">{INTRO[id]}</p>
    </header>
    <div class="mt-8">
      {id === "colour" && (
        /* each swatch on its own theme's page colour, inside that theme's hairline: a dark swatch
           stays visible on a light page and a light one on a dark page */
        <div class={box} role="region" aria-label="Colours" tabindex="0">
          <table class="w-full min-w-[44rem] border-collapse">
            <thead><tr><th class={th}>Token</th><th class={`${th} w-60`}>Light</th><th class={`${th} w-60`}>Dark</th></tr></thead>
            <tbody class="[&>tr:last-child>td]:border-b-0">
              {Object.entries(tokens.color).map(([k, v]) => { const { light, dark } = both(v); const use = desc("color", k); return (
                <tr data-docs-colour={k}>
                  <td class={td}>
                    <code class={`${code} whitespace-nowrap`}>{`--fndn-${k}`}</code>
                    {use && <p class="mt-1 text-xs leading-normal text-ink-2">{use}</p>}
                  </td>
                  {([["light", light], ["dark", dark]] as const).map(([theme, value]) => (
                    <td class={td}>
                      <span class="flex items-center gap-2.5">
                        <span class="grid size-9 shrink-0 place-items-center rounded-control" style={`background:${PAGE[theme]};box-shadow:inset 0 0 0 1px ${LINE[theme]}`}>
                          <span class="size-6 rounded-chip" style={`background:${value};box-shadow:inset 0 0 0 1px ${LINE[theme]}`}></span>
                        </span>
                        <code class="font-mono text-2xs whitespace-nowrap text-ink-2">{value}</code>
                      </span>
                    </td>
                  ))}
                </tr>
              ); })}
            </tbody>
          </table>
        </div>
      )}

      {id === "type" && (
        <div class={box} role="region" aria-label="Type" tabindex="0">
          <table class={table}>
            <thead><tr><th class={th}>Token</th><th class={th}>Value</th><th class={th}>Sample</th></tr></thead>
            <tbody class="[&>tr:last-child>td]:border-b-0">
              {Object.entries(tokens.text).map(([k, v]) => (
                <tr><td class={td}><code class={code}>{`text-${k}`}</code></td><td class={td}><code class={codeMuted}>{String(v)}</code></td><td class={td}><span style={`font-size:var(--fndn-text-${k})`}>{SAMPLE}</span></td></tr>
              ))}
              {Object.entries(tokens.font).map(([k, v]) => (
                <tr><td class={td}><code class={code}>{`font-${k}`}</code></td><td class={td}><code class={codeMuted}>{String(v).split(",")[0]}</code></td><td class={td}><span style={`font-family:var(--fndn-font-${k})`}>{k === "mono" ? "const invoice = await bill({ plan });" : "Approve the renewal of 1,284 seats"}</span></td></tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {id === "elevation" && (
        <ul class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,14rem),1fr))] gap-6">
          {Object.keys(tokens.shadow).map((k) => (
            <li class="flex flex-col gap-3">
              <div class="h-24 rounded-card bg-surface" style={`box-shadow:var(--fndn-shadow-${k})`}></div>
              <code class={code}>{`shadow-${k}`}</code>
              <span class="text-sm text-ink-2">{desc("shadow", k)}</span>
            </li>
          ))}
        </ul>
      )}

      {id === "shape" && (
        <ul class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,12rem),1fr))] gap-6">
          {Object.entries(tokens.radius).map(([k, v]) => (
            <li class="flex flex-col gap-2">
              <div class="h-20 border border-line-strong bg-inset" style={`border-radius:var(--fndn-radius-${k})`}></div>
              <span class="flex items-baseline gap-2"><code class={code}>{`rounded-${k}`}</code><code class={codeMuted}>{String(v)}</code></span>
              <span class="text-sm text-ink-2">{desc("radius", k)}</span>
            </li>
          ))}
        </ul>
      )}

      {id === "motion" && motion && (
        <MotionFoundation client:load timings={timings()} timingsNote={timingsDescription()} durationNote={groupDesc("duration")} durations={motion.durations} easings={motion.easings} values={motion.values} />
      )}

      {id === "icons" && (
        <div class="flex flex-col gap-4">
          <IconFilter client:load total={iconNames.length} />
          <ul class="grid grid-cols-[repeat(auto-fill,minmax(8.5rem,1fr))] gap-2" data-docs-icons>
            {iconNames.map((n) => (
              <li data-name={n}>
                <button type="button" data-docs-icon={n} aria-label={`Copy ${n}`} class="flex h-full w-full flex-col items-center gap-2 rounded-control border border-line bg-surface px-2 pt-4 pb-3 text-ink motion-colors-fast hover:bg-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
                  <span class="text-2xl" set:html={iconSvg(n, 'width="1em" height="1em" aria-hidden="true"')} />
                  <code class="max-w-full font-mono text-2xs wrap-anywhere text-ink-2">{n}</code>
                  <span class="text-2xs text-ink-2">{icons[n].weight}</span>
                </button>
              </li>
            ))}
          </ul>
        </div>
      )}

      {id === "spacing" && (
        <div class={box} role="region" aria-label="Spacing" tabindex="0">
          <table class={table}>
            <thead><tr><th class={th}>Token</th><th class={th}>Value</th><th class={th}><span class="sr-only">Bar</span></th></tr></thead>
            <tbody class="[&>tr:last-child>td]:border-b-0">
              {Object.entries(tokens.space).map(([k, v]) => (
                <tr><td class={td}><code class={code}>{`--fndn-space-${k}`}</code></td><td class={td}><code class={codeMuted}>{String(v)}</code></td><td class={td}><span class="block h-3 rounded-chip bg-accent" style={`inline-size:var(--fndn-space-${k})`}></span></td></tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>
  </div>
</Layout>
