  "radius": {
    "$type": "dimension",
    "$description": "Tight radii: chip 6, control 8, card 10, window 14, pill 999. shape and shape-sm are the app's shape: a pill, or control and chip in a rounded app.",
    "chip": {
      "$value": "6px"
    },
    "control": {
      "$value": "8px"
    },
    "card": {
      "$value": "10px"
    },
    "window": {
      "$value": "14px"
    },
    "pill": {
      "$value": "999px"
    },
    "shape": {
      "$value": "{radius.pill}",
      "$rounded": "{radius.control}",
      "$description": "The corner of a button, toggle or segmented control of 32px or more that names no shape of its own: the app's shape. A pill, or radius.control in a rounded app (\"shape\": \"rounded\" in the project's fndn.json)."
    },
    "shape-sm": {
      "$value": "{radius.pill}",
      "$rounded": "{radius.chip}",
      "$description": "The same for a control of 28px or less: a pill, or radius.chip in a rounded app, the corner of a field of that height."
    }
  },
  "font": {
    "$type": "fontFamily",
    "$description": "Inter with tight tracking and tabular numerals, JetBrains Mono for code. Each stack names the variable font first (the family the @fontsource-variable packages register), then the static one.",
    "sans": {
      "$value": [
        "Inter Variable",
        "Inter",
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": [
        "JetBrains Mono Variable",
        "JetBrains Mono",
        "ui-monospace",
        "SF Mono",
        "monospace"
      ]
    }
  },
  "text": {
    "$type": "dimension",
    "$description": "Type scale. Body is 14px; UI chrome lives at 12–13px.",
    "2xs": {
      "$value": "11px"
    },
    "xs": {
      "$value": "12px"
    },
    "dense": {
      "$value": "12.5px",
      "$description": "Dense rows: the options of a popup, table header cells, lines of code."
    },
    "sm": {
      "$value": "13px"
    },
    "md": {
      "$value": "14px"
    },
    "lg": {
      "$value": "16px"
    },
    "xl": {
      "$value": "20px"
    }
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": "4px"
    },
    "2": {
      "$value": "8px"
    },
    "3": {
      "$value": "12px"
    },
    "4": {
      "$value": "16px"
    },
    "5": {
      "$value": "20px"
    },
    "6": {
      "$value": "24px"
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "$description": "Strong custom curves; the built-in CSS easings are too weak for deliberate motion. Entering/exiting uses out-strong, on-screen movement uses move, colour and opacity changes use the built-in `ease`, loops use `linear`. Never ease-in.",
    "out-strong": {
      "$value": [
        0.23,
        1,
        0.32,
        1
      ],
      "$description": "Strong ease-out. Entrances, exits, press feedback, reveals, popups."
    },
    "in-out-strong": {
      "$value": [
        0.77,
        0,
        0.175,
        1
      ],
      "$description": "Strong ease-in-out. Elements that are already on screen and travel or morph."
    },
    "move": {
      "$value": [
        0.77,
        0,
        0.175,
        1
      ],
      "$description": "Sliding indicators (segmented thumb, switch thumb). Aliases in-out-strong; change here to retune every indicator at once."
    },
    "drawer": {
      "$value": [
        0.32,
        0.72,
        0,
        1
      ],
      "$description": "iOS-like sheet/drawer curve."
    },
    "link": {
      "$value": [
        0.16,
        1,
        0.3,
        1
      ],
      "$description": "Animated link underline."
    }
  },
  "duration": {
    "$type": "duration",
    "$description": "UI motion stays under 300ms. Every transition and animation takes its duration from here; literal durations are a lint error (loops excepted).",
    "fast": {
      "$value": "100ms",
      "$description": "Hover and colour feedback."
    },
    "base": {
      "$value": "150ms",
      "$description": "Small state changes: colour, opacity, focus rings."
    },
    "press": {
      "$value": "160ms",
      "$description": "Press feedback (scale on :active)."
    },
    "tooltip": {
      "$value": "125ms",
      "$description": "Tooltips and other tiny popovers."
    },
    "popup": {
      "$value": "180ms",
      "$description": "Selects, menus, popovers, hover cards."
    },
    "reveal": {
      "$value": "200ms",
      "$reducedMotion": "0ms",
      "$description": "Collapsible regions (the one sanctioned height-like animation)."
    },
    "move": {
      "$value": "200ms",
      "$reducedMotion": "0ms",
      "$description": "On-screen travel: sliding thumbs, gliding highlights, chevron rotation."
    },
    "slow": {
      "$value": "250ms",
      "$description": "Dialogs and larger surfaces."
    },
    "enter": {
      "$value": "300ms",
      "$description": "One-shot entrances of content (fade-up). The upper bound for UI."
    },
    "stagger": {
      "$value": "40ms",
      "$reducedMotion": "0ms",
      "$description": "Delay between items of a group entrance (30–80ms budget). Cap the multiplier so a long list never waits."
    },
    "sweep": {
      "$value": "1000ms",
      "$reducedMotion": "0ms",
      "$description": "The prompt bar's send sweep: a decorative band crossing the composer once. Longer than any UI motion on purpose, so the band is seen travelling. Not for anything a user waits on."
    }
  },
  "$transitions": {
    "$description": "Named timings for transitions: [duration token, easing token or CSS keyword]. They become the motion-<what>-<name> utilities of the Tailwind preset (motion-colors-fast, motion-transform-press). These are the only timings a recipe can use.",
    "fast": [
      "fast",
      "ease"
    ],
    "base": [
      "base",
      "ease"
    ],
    "slow": [
      "slow",
      "ease"
    ],
    "press": [
      "press",
      "out-strong"
    ],
    "move": [
      "move",
      "out-strong"
    ],
    "glide": [
      "move",
      "move"
    ],
    "reveal": [
      "reveal",
      "out-strong"
    ],
    "popup": [
      "popup",
      "out-strong"
    ],
    "tooltip": [
      "tooltip",
      "out-strong"
    ],
    "enter": [
      "enter",
      "out-strong"
    ],
    "fast-out": [
      "fast",
      "out-strong"
    ],
    "base-out": [
      "base",
      "out-strong"
    ],
    "slow-out": [
      "slow",
      "out-strong"
    ]
  },
  "motion": {
    "$type": "number",
    "$description": "Shared motion quantities. Each carries its reduced-motion value, so `prefers-reduced-motion` keeps fades and colour but drops travel everywhere at once.",
    "press-scale": {
      "$value": 0.97,
      "$description": "Scale of a pressed button, chip or icon button. Subtle: 0.95–0.98."
    },
    "press-scale-sm": {
      "$value": 0.9,
      "$description": "Scale of a pressed control of 20px or less (checkbox box, radio, switch thumb). 0.97 moves a 16px box by under half a pixel, which cannot be seen."
    },
    "enter-shift": {
      "$value": "8px",
      "$reducedMotion": "0px",
      "$description": "Rise of a one-shot entrance (fndn-fade-up)."
    },
    "popup-scale": {
      "$value": 0.96,
      "$reducedMotion": 1,
      "$description": "Closed-state scale of trigger-anchored popups. Never 0; nothing appears from nothing."
    },
    "sheet-shift": {
      "$value": "100%",
      "$reducedMotion": "0%",
      "$description": "How far a closed sheet (drawer) sits past its edge. Reduced motion: none, the sheet fades in place."
    },
    "stagger-max": {
      "$value": 5,
      "$description": "Largest stagger multiplier. Items past it arrive with the last staggered one."
    },
    "carousel-depth-scale": {
      "$value": 0.94,
      "$reducedMotion": 1,
      "$description": "Scale of a carousel slide (effect depth) as it starts to enter or finishes leaving the view; full size once it is all in view. Reduced motion: none."
    },
    "carousel-depth-opacity": {
      "$value": 0.5,
      "$reducedMotion": 1,
      "$description": "Opacity of a carousel slide (effect depth) at the same moments as its scale. Reduced motion: none, the slide only scrolls."
    },
    "carousel-parallax-shift": {
      "$value": 0.2,
      "$reducedMotion": 0,
